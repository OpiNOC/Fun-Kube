deployment:
  enabled: true
  kind: DaemonSet

ingressClass:
  enabled: true
  isDefaultClass: {{ traefik_is_default_class | bool | lower }}
  name: traefik

providers:
  kubernetesIngress:
    enabled: true
  kubernetesCRD:
    enabled: true

service:
  enabled: true
{% if ingress_service_type == "loadbalancer" and traefik_lb_ip %}
  annotations:
    metallb.io/loadBalancerIPs: "{{ traefik_lb_ip }}"
{% endif %}
  # Chart >= 41: il tipo va in service.spec.type (service.type viene ignorato)
  spec:
    type: {{ "LoadBalancer" if ingress_service_type == "loadbalancer" else "NodePort" }}
    externalTrafficPolicy: Local

ports:
  web:
    port: 8000
    expose:
      default: true
    exposedPort: 80
{% if ingress_service_type == "nodeport" %}
    nodePort: {{ traefik_http_nodeport }}
{% endif %}
  websecure:
    port: 8443
    expose:
      default: true
    exposedPort: 443
{% if ingress_service_type == "nodeport" %}
    nodePort: {{ traefik_https_nodeport }}
{% endif %}

api:
  dashboard: true

ingressRoute:
  dashboard:
    enabled: false
