# =============================================================================
# Fun-Kube — Cluster Configuration
# =============================================================================
# Copia questo file in .env e modifica i valori per il tuo ambiente.
#
#   cp .env.example .env
#
# Il file .env NON viene committato su git.
#
# TOPOLOGIE (rilevate automaticamente):
#
#   Local-node        LOCAL_NODE=true, 1 CP, 0 worker
#                     La bootstrap machine È il nodo (tutto in locale)
#
#   Mononodo          1 CP, 0 worker
#                     1 VM remota, fa tutto da sola
#
#   Single CP         1 CP + N worker
#                     1 control-plane + nodi worker separati
#
#   HA multi-CP       3+ CP + N worker + keepalived VIP
#                     Cluster ad alta disponibilità
#
# Nota: se non definisci worker, i nodi CP vengono detaintati automaticamente
# e schedulano anche i workload applicativi.
# =============================================================================


# -----------------------------------------------------------------------------
# CLUSTER
# -----------------------------------------------------------------------------
CLUSTER_NAME=mycluster


# -----------------------------------------------------------------------------
# MODALITÀ LOCAL-NODE
# Imposta true se la bootstrap machine coincide con il nodo stesso.
# In questo caso SSH_USER e SSH_KEY_PATH non sono necessari.
# Compatibile solo con topologia mononodo (1 CP, 0 worker).
# -----------------------------------------------------------------------------
LOCAL_NODE=false


# -----------------------------------------------------------------------------
# NODI
# Formato: NODE_<N>_IP / NODE_<N>_ROLE / NODE_<N>_HOSTNAME
# ROLE: control-plane | worker
#
# Aggiungi o rimuovi blocchi NODE_<N> in base alla topologia desiderata.
# I nodi vengono letti in sequenza fino al primo buco (NODE_1, NODE_2, ...).
#
# Topologie:
#   Mononodo:     solo NODE_1 (control-plane)
#   Single CP:    NODE_1 (control-plane) + NODE_4..6 (worker)
#   HA multi-CP:  NODE_1..3 (control-plane) + NODE_4..6 (worker)
# -----------------------------------------------------------------------------
NODE_1_IP=10.0.0.1
NODE_1_ROLE=control-plane
NODE_1_HOSTNAME=cp1

# NODE_2_IP=10.0.0.2
# NODE_2_ROLE=control-plane
# NODE_2_HOSTNAME=cp2

# NODE_3_IP=10.0.0.3
# NODE_3_ROLE=control-plane
# NODE_3_HOSTNAME=cp3

# NODE_4_IP=10.0.0.4
# NODE_4_ROLE=worker
# NODE_4_HOSTNAME=worker1

# NODE_5_IP=10.0.0.5
# NODE_5_ROLE=worker
# NODE_5_HOSTNAME=worker2

# NODE_6_IP=10.0.0.6
# NODE_6_ROLE=worker
# NODE_6_HOSTNAME=worker3


# -----------------------------------------------------------------------------
# SSH
# Non necessari se LOCAL_NODE=true.
# La chiave SSH deve essere pre-caricata sui nodi (authorized_keys).
# L'utente SSH deve poter fare sudo senza password.
# -----------------------------------------------------------------------------
SSH_USER=ubuntu
SSH_KEY_PATH=~/.ssh/id_rsa


# -----------------------------------------------------------------------------
# TIMEZONE
# Applicato a tutti i nodi del cluster.
# -----------------------------------------------------------------------------
CLUSTER_TIMEZONE=Europe/Rome


# -----------------------------------------------------------------------------
# KUBERNETES
# K8S_VERSION: vuoto = versione testata (fun_kube/versions.py),
#              'latest' = ultima stabile upstream, oppure es. v1.35.9
#
# Le versioni degli altri componenti core e addon (containerd, Calico,
# cert-manager, metrics-server, local-path, MetalLB, Longhorn) sono fissate
# nel repo in fun_kube/versions.py, con i manifest vendored in ansible/roles/.
# -----------------------------------------------------------------------------
K8S_VERSION=v1.35.9
POD_CIDR=172.16.0.0/16
SERVICE_CIDR=10.96.0.0/12


# -----------------------------------------------------------------------------
# CERTIFICATI API SERVER — SANs aggiuntivi (opzionale)
# IP o hostname extra da includere nel certificato TLS dell'API server.
# Utile se vuoi raggiungere il cluster tramite un IP pubblico o un hostname.
# I CP IPs e la VIP keepalived sono inclusi automaticamente.
# Separati da virgola: es. 203.0.113.10,k8s.miodominio.com
# -----------------------------------------------------------------------------
API_SERVER_EXTRA_SANS=


# -----------------------------------------------------------------------------
# KEEPALIVED — VIP per HA (obbligatorio se CP >= 3)
# VIP: un IP libero sulla subnet dei nodi, non assegnato ad alcun nodo.
# INTERFACE: interfaccia di rete dei nodi CP su cui gira VRRP (es. eth0, ens18).
#            Vuoto = auto-detect (l'interfaccia che ha l'IP del nodo indicato in NODE_N_IP).
# -----------------------------------------------------------------------------
KEEPALIVED_ENABLED=false
KEEPALIVED_VIP=10.0.0.100
KEEPALIVED_INTERFACE=           # vuoto = auto-detect


# -----------------------------------------------------------------------------
# ADDON — MetalLB (load balancer per IP on-premise)
# IP_POOL: range di IP liberi sulla subnet dei nodi.
# Non deve sovrapporsi a POD_CIDR o SERVICE_CIDR.
# -----------------------------------------------------------------------------
METALLB_ENABLED=false
METALLB_IP_POOL=10.0.0.200-10.0.0.220


# -----------------------------------------------------------------------------
# ADDON — Ingress controller
# TYPE: traefik | nginx-proxy-manager
# SERVICE_TYPE: auto       = LoadBalancer se MetalLB attivo, altrimenti NodePort
#               loadbalancer = richiede MetalLB
#               nodeport     = espone su NodePort (funziona sempre)
# -----------------------------------------------------------------------------
INGRESS_ENABLED=false
INGRESS_TYPE=nginx-proxy-manager
INGRESS_SERVICE_TYPE=auto

# Traefik (usato solo se INGRESS_TYPE=traefik)
# TRAEFIK_LB_IP=            # IP specifico dal pool MetalLB (vuoto = auto-assign)
TRAEFIK_HTTP_NODEPORT=30080
TRAEFIK_HTTPS_NODEPORT=30443
TRAEFIK_IS_DEFAULT_CLASS=true
# TRAEFIK_CHART_VERSION=    # vuoto = chart testato (fun_kube/versions.py); richiede chart >= 41
# TRAEFIK_DASHBOARD_HOST=   # es. traefik.miodominio.com — vuoto = solo port-forward
# TRAEFIK_ACME_EMAIL=       # es. admin@miodominio.com — vuoto = guida in output/

# Nginx Proxy Manager (usato solo se INGRESS_TYPE=nginx-proxy-manager)
# NPM_LB_IP=                # IP specifico dal pool MetalLB (vuoto = auto-assign)
NPM_HTTP_NODEPORT=30080
NPM_HTTPS_NODEPORT=30443
NPM_ADMIN_NODEPORT=30081
NPM_DB_PASSWORD=T1sh-PwD-Sh0ulD-B3-Ch4nGeD-NOW


# -----------------------------------------------------------------------------
# ADDON — Longhorn (storage distribuito)
#
# Funziona su qualsiasi numero di nodi. Le repliche vengono calcolate
# automaticamente in base ai nodi schedulabili:
#   1 nodo  → 1 replica (nessuna ridondanza)
#   2 nodi  → 2 repliche (ridondanza parziale)
#   3+ nodi → 3 repliche (ridondanza piena, consigliato)
# Fun-Kube avvisa durante 'up' se le repliche sono inferiori a 3.
#
# RWX: abilita StorageClass ReadWriteMany (longhorn-rwx) — necessaria per
#      Nginx Proxy Manager su cluster multi-nodo.
# UI_NODEPORT: espone la dashboard Longhorn su NodePort.
#              Lasciare a 0 per non esporre la UI.
# Prerequisiti (nfs-common, open-iscsi) installati automaticamente su tutti i nodi.
# -----------------------------------------------------------------------------
LONGHORN_ENABLED=false
LONGHORN_RWX=false
LONGHORN_UI_NODEPORT=31080


# -----------------------------------------------------------------------------
# ADDON — DN-essence (DNS rewrite manager per CoreDNS)
#
# Gestisce regole di riscrittura DNS in CoreDNS via Custom Resources Kubernetes.
# Utile per risolvere hairpin NAT (domini pubblici che devono risolvere a IP interni).
# Offre UI web, REST API e integrazione kubectl (kubectl get dnsrewrite).
#
# UI_NODEPORT: porta NodePort per accedere alla UI web.
#              Lasciare a 0 per non esporre la UI (accesso solo via port-forward).
# VERSION: versione del Helm chart (vuoto = ultima versione dal registry OCI).
# -----------------------------------------------------------------------------
DN_ESSENCE_ENABLED=true
DN_ESSENCE_UI_NODEPORT=30880   # 0 = UI non esposta (ClusterIP only, usa port-forward)
# DN_ESSENCE_VERSION=          # vuoto = ultima versione


# -----------------------------------------------------------------------------
# ADDON — Monitoring (Prometheus, Alertmanager, Grafana, Loki, Alloy)
#
# Metriche, log dei pod, eventi Kubernetes e alerting nel namespace "monitoring".
# Abilitandolo, Fun-Kube espone anche le metriche del control plane (scheduler,
# controller-manager, etcd, kube-proxy) su 0.0.0.0: senza, gli alert
# KubeSchedulerDown / etcdMembersDown ecc. scatterebbero sempre.
# Prometheus e Alertmanager non vengono mai esposti (usare kubectl port-forward).
# -----------------------------------------------------------------------------
MONITORING_ENABLED=false

# --- Esposizione di Grafana: scegliere UNA modalità --------------------------
#   loadbalancer  IP dedicato da MetalLB, raggiungibile sulla rete dei nodi
#   nodeport      porta fissa su tutti i nodi: http://<IP nodo>:GRAFANA_NODEPORT
#   clusterip     solo dentro il cluster: da pubblicare con Nginx Proxy Manager
#                 (nel cluster) o con il virtual host Traefik (vedi sotto)
#   auto          loadbalancer se MetalLB è abilitato, altrimenti nodeport
# Nessuna modalità pubblica Grafana su Internet da sola: serve un proxy o un NAT.
# loadbalancer e nodeport sono in HTTP: adatti a una rete di management fidata.
GRAFANA_EXPOSE=auto

# loadbalancer
GRAFANA_LB_IP=auto                 # auto = IP assegnato da MetalLB (letto e mostrato
                                   # a fine installazione), oppure un IP del METALLB_IP_POOL
GRAFANA_ALLOWED_CIDRS=             # opzionale: reti che possono raggiungere Grafana.
                                   # Separate da VIRGOLA, senza spazi, notazione CIDR
                                   # (un singolo host: /32). Vuoto = nessun limite. Es.:
                                   # GRAFANA_ALLOWED_CIDRS=10.0.0.0/24,192.168.10.0/24,203.0.113.7/32

# nodeport
GRAFANA_NODEPORT=30300             # "3000" (porta standard di Grafana) nel range 30000-32767

# clusterip
GRAFANA_TRAEFIK_INGRESS=false      # true  = crea il virtual host Traefik su GRAFANA_DOMAIN
                                   #         (richiede INGRESS_TYPE=traefik; HTTPS con Let's
                                   #         Encrypt se TRAEFIK_ACME_EMAIL è impostato)
                                   # false = a fine installazione viene indicato il nome
                                   #         interno da inserire in Nginx Proxy Manager:
                                   #         kube-prometheus-stack-grafana.monitoring.svc.cluster.local:80
                                   # Senza GRAFANA_DOMAIN Grafana resta raggiungibile solo con:
                                   #   kubectl port-forward -n monitoring svc/kube-prometheus-stack-grafana 3000:80

# Dominio: impostarlo SOLO se un proxy (NPM, Traefik o un proxy esterno davanti
# all'IP/NodePort) pubblica Grafana con questo nome. Diventa il root_url di Grafana:
# se Grafana si usa direttamente via IP lasciarlo vuoto, altrimenti redirect e login
# non funzionano.
GRAFANA_DOMAIN=                    # es. grafana.cluster.dominio.it

# --- Accesso, storage, retention ---------------------------------------------
GRAFANA_ADMIN_PASSWORD=            # vuoto = generata alla prima installazione (poi riletta
                                   # dal cluster). Grafana la conserva nel suo database:
                                   # dopo la prima installazione si cambia da Grafana.
MONITORING_STORAGE_CLASS=auto      # auto = longhorn-monitoring (creata: max 2 repliche,
                                   # Retain) con Longhorn, local-path sul mononodo;
                                   # su multi-nodo senza Longhorn indicare una StorageClass
# Dimensioni dei volumi: NON si possono cambiare dopo l'installazione. Con Longhorn,
# up verifica prima che ci sia spazio prenotabile (dimensioni × repliche, max 2).
# Default per un cluster piccolo/medio (fino a ~10 nodi, qualche centinaio di pod):
# 22Gi in totale. Per un cluster grande (decine di nodi, migliaia di pod):
#   PROM_STORAGE=30Gi PROM_RETENTION_SIZE=25GB LOKI_STORAGE=20Gi
#   GRAFANA_STORAGE=5Gi ALERTMANAGER_STORAGE=2Gi
# Prometheus: ~0,3-0,5 GB/giorno ogni 100k serie; retentionSize (~80% del volume)
#   evita che il disco si riempia. Loki: retention SOLO a tempo; con applicazioni
#   molto verbose aumentare LOKI_STORAGE o ridurre LOKI_RETENTION (l'alert
#   KubePersistentVolumeFillingUp avvisa prima che il volume sia pieno).
PROM_RETENTION=15d
PROM_RETENTION_SIZE=8GB            # deve essere minore di PROM_STORAGE (~80%)
PROM_STORAGE=10Gi
LOKI_RETENTION=168h                # 7 giorni
LOKI_STORAGE=10Gi
GRAFANA_STORAGE=1Gi                # solo il database di Grafana (utenti, dashboard)
ALERTMANAGER_STORAGE=1Gi           # solo silenzi e stato delle notifiche

# --- Notifiche ----------------------------------------------------------------
ALERTMANAGER_SLACK_WEBHOOK=        # vuoto = nessuna notifica
ALERTMANAGER_SLACK_CHANNEL=#alert-k8s


# -----------------------------------------------------------------------------
# OUTPUT E DEBUG
# -----------------------------------------------------------------------------
OUTPUT_DIR=./output
LOG_LEVEL=info              # info | debug
